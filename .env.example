# ===== DOCKET RECEPTIONIST — local config template =====
# Copy this file to .env and fill in YOUR values.
# NEVER commit .env to git, share it, or paste it into chat.
# Use a READ-ONLY database login (not an admin account).

# stub = sample CSV | sqlserver = your own SQL Server
DOCKET_STORE_TYPE=

# SQL Server — leave blank until you fill your own .env
DOCKET_SQL_SERVER=
DOCKET_SQL_DATABASE=
DOCKET_SQL_USER=
DOCKET_SQL_PASSWORD=

# Optional table/column mapping (if you use table lookup later)
DOCKET_SQL_TABLE=
DOCKET_SQL_COL_DOCKET=
DOCKET_SQL_COL_STATUS=
DOCKET_SQL_COL_LOCATION=
DOCKET_SQL_COL_ETA=

# Your own stored procedure / enquiry name (user choice — set in .env only)
DOCKET_SQL_SP_NAME=

# Spoken in the greeting
DOCKET_COMPANY_NAME=
